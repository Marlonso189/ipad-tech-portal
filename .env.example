# From-source compose (docker-compose.yml) builds the image and mounts config.yaml.
# The paste-in stack is deploy/docker-compose.yml. It pulls ghcr.io and needs no file.
# No credentials belong in this file. The Jamf server URL is typed at sign-in.

# Hostname Caddy serves for the from-source compose file.
PORTAL_HOST=ipad-tech.example.org

# Use ./deploy/Caddyfile to serve a certificate from ./certs/cert.pem and ./certs/key.pem.
CADDYFILE=./deploy/Caddyfile.internal

# Optional portal settings. An empty value leaves the built-in default,
# except ITP_GROUP_ALLOWLIST and ITP_GROUP_PREFIX, where empty is meaningful.
# ITP_VERIFY_TLS=true
# ITP_TIMEOUT_SECONDS=30
# ITP_IDLE_TIMEOUT_MINUTES=15
# ITP_GROUP_ALLOWLIST=
# ITP_GROUP_PREFIX=Tech-
# ITP_AUDIT_RETENTION_DAYS=90
# ITP_AUDIT_MAX_BYTES=10485760
# ITP_UPDATE_INVENTORY=true
# ITP_LOG_LEVEL=INFO

# Lab only. Leave unset. Allows an HTTP page and an HTTP Jamf URL.
# ITP_INSECURE_TEST_MODE=true
