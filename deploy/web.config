<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy for the iPad Tech Portal.
  Place this file in the IIS site root. The Python process listens on
  http://127.0.0.1:8741 (server.port in config.yaml). Change that host
  and port here if config.yaml uses different values.

  Requires the URL Rewrite module and Application Request Routing.
  ARR proxy must be enabled, and the server variables below must be allowed.
  See the README for the appcmd commands.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="RedirectHttpToHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="ReverseProxyToIpadTechPortal" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8741/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
